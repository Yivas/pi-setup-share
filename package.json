{
  "name": "pi-setup-share",
  "version": "0.1.1",
  "description": "Selectively export, inspect, import, and restore Pi setups through a native assistant.",
  "keywords": ["pi-package", "pi", "setup", "configuration", "sharing"],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yivas/pi-setup-share.git"
  },
  "homepage": "https://github.com/Yivas/pi-setup-share#readme",
  "bugs": {
    "url": "https://github.com/Yivas/pi-setup-share/issues"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
